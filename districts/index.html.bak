   <!-- ══════════════════════════════════════════
     HERO
══════════════════════════════════════════ -->
   <div class="directory-hero">
      <h1>New York Districts Directory</h1>
      <p>Find specialized parent guides, CSE evaluation timelines, and impartial hearing contacts tailored directly to your local school district.</p>
   </div>

   <!-- ══════════════════════════════════════════
     CONTROLS
══════════════════════════════════════════ -->
   <div class="controls-container">
      <div class="search-box">
         <input id="searchInput" placeholder="🔍 Search by district name, borough, or county…" type="text" autocomplete="off" />
      </div>
      <div class="filter-box">
         <select id="typeFilter">
            <option value="all">Region: All NY</option>
            <option value="nyc">NYC DOE Districts</option>
            <option value="li">Long Island</option>
            <option value="upstate">Upstate NY</option>
            <option value="westchester">Westchester / Hudson</option>
         </select>
         <select id="sortFilter">
            <option value="az">Sort: A → Z</option>
            <option value="za">Sort: Z → A</option>
         </select>
      </div>
   </div>

   <!-- ══════════════════════════════════════════
     DISTRICT GRID
══════════════════════════════════════════ -->
   <div class="district-grid" id="districtGrid"></div>
   <div id="noResults">No districts match your search. Try a different name or filter.</div>
   <div class="page-bottom"></div>

   <!-- ══════════════════════════════════════════
