      function badgeClass(type) {
         if (type === 'nyc') return 'badge-nyc';
         if (type === 'li') return 'badge-li';
         return 'badge-nys';
      }

      function badgeLabel(type) {
         if (type === 'nyc') return 'NYC DOE';
         if (type === 'li') return 'Long Island';
         if (type === 'westchester') return 'Westchester / Hudson';
         return 'Upstate NY';
      }

      function renderCards(list) {
         const grid = document.getElementById('districtGrid');
         const noRes = document.getElementById('noResults');
         if (!list.length) {
            grid.innerHTML = '';
            noRes.style.display = 'block';
            return;
         }
         noRes.style.display = 'none';
         grid.innerHTML = list.map(d => `
    <a class="district-card" href="/districts/${d.slug}/">
      <span class="district-type-badge ${badgeClass(d.type)}">${badgeLabel(d.type)}</span>
      <div class="district-name">${d.name}</div>
      <div class="district-county">${d.region} · ${d.county}</div>
      <div class="district-desc">${d.desc}</div>
      <span class="district-cta">View Resources</span>
    </a>
  `).join('');
      }

      function applyFilters() {
         const q = document.getElementById('searchInput').value.toLowerCase().trim();
         const type = document.getElementById('typeFilter').value;
         const sort = document.getElementById('sortFilter').value;

         let list = DISTRICTS.filter(d => {
            const matchType = type === 'all' || d.type === type;
            const matchSearch = !q ||
               d.name.toLowerCase().includes(q) ||
               d.county.toLowerCase().includes(q) ||
               d.region.toLowerCase().includes(q);
            return matchType && matchSearch;
         });

         list.sort((a, b) => sort === 'za' ?
            b.name.localeCompare(a.name) :
            a.name.localeCompare(b.name)
         );

         renderCards(list);
      }

      document.getElementById('searchInput').addEventListener('input', applyFilters);
      document.getElementById('typeFilter').addEventListener('change', applyFilters);
      document.getElementById('sortFilter').addEventListener('change', applyFilters);

      // Mobile nav toggle
      document.getElementById('mobileToggle').addEventListener('click', function() {
         const menu = document.getElementById('mobileMenu');
         menu.classList.toggle('open');
      });

      // Initial render
      applyFilters();
   </script>

