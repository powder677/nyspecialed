<script type="application/ld+json">
   {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I request an initial evaluation for my child suspected of having a disability in Yonkers City School District?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To request an initial evaluation, submit a written request to the school principal or the district's Committee on Special Education (CSE). The request should clearly state your concerns about your child's academic or developmental progress and the reasons you believe they may have a disability. The district then has 60 school days to complete the evaluation, from the date of your written consent."
      }
    },
    {
      "@type": "Question",
      "name": "What is the timeline for the CSE to develop an IEP after the initial evaluation is completed in Yonkers City SD?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After the initial evaluation is completed and your child is found eligible for special education services, the CSE has 60 school days from the date of consent for testing to develop an Individualized Education Program (IEP). You, as the parent, are a critical member of the CSE team and must be invited to participate in the IEP development meeting."
      }
    },
    {
      "@type": "Question",
      "name": "What if I disagree with the IEP developed by the CSE for my child in Yonkers City School District?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you disagree with the IEP, you have several options. You can request an IEP meeting to further discuss your concerns and propose modifications to the IEP. You can also pursue mediation with the district to attempt to reach a mutually agreeable resolution. If these steps are unsuccessful, you have the right to file a formal complaint with the NYSED or request an impartial hearing to challenge the IEP."
      }
    },
    {
      "@type": "Question",
      "name": "How often will my child's IEP be reviewed and updated in Yonkers City SD?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your child's IEP must be reviewed and updated at least annually. This is known as the Annual Review. However, you can request an IEP meeting at any time if you have concerns about your child's progress or if there have been significant changes in their educational needs. Additionally, a reevaluation must occur at least every three years, unless the CSE and parents agree it is not needed."
      }
    },
    {
      "@type": "Question",
      "name": "What are my rights if Yonkers City School District fails to implement my child's IEP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If the district fails to implement your child's IEP, you should first notify the school principal and the CSE chairperson in writing. Document all instances of non-compliance. If the issues persist, you can file a complaint with the NYSED or request an impartial hearing. You may also be able to pursue legal remedies to ensure your child receives the services and supports outlined in their IEP."
      }
    },
    {
      "@type": "Question",
      "name": "What related services are available to students with IEPs in Yonkers City School District, and how do I request them?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Related services may include speech therapy, occupational therapy, physical therapy, counseling, transportation, and assistive technology. To request related services, you should discuss your child's needs with the CSE during the IEP development process. The IEP must specify the frequency, duration, and location of any related services deemed necessary to support your child's educational goals."
      }
    }
  ]
}
  </script>
