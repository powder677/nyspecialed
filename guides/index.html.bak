   <!-- ═══════════ FILTER SCRIPT ═══════════ -->
   <script>
      (function() {
         var btns = document.querySelectorAll('.filter-btn');
         var sections = document.querySelectorAll('.category-section');

         btns.forEach(function(btn) {
            btn.addEventListener('click', function() {
               var filter = this.getAttribute('data-filter');

               btns.forEach(function(b) {
                  b.classList.remove('active');
               });
               this.classList.add('active');

               if (filter === 'all') {
                  sections.forEach(function(s) {
                     s.removeAttribute('data-hidden');
                     s.querySelectorAll('.hub-card').forEach(function(c) {
                        c.removeAttribute('data-hidden');
                     });
                  });
               } else {
                  sections.forEach(function(section) {
                     var cards = section.querySelectorAll('.hub-card');
                     var hasVisible = false;
                     cards.forEach(function(card) {
                        if (card.getAttribute('data-cat') === filter) {
                           card.removeAttribute('data-hidden');
                           hasVisible = true;
                        } else {
                           card.setAttribute('data-hidden', 'true');
                        }
                     });
                     hasVisible
                        ?
                        section.removeAttribute('data-hidden') :
                        section.setAttribute('data-hidden', 'true');
                  });
               }
            });
         });
      })();
   </script>

