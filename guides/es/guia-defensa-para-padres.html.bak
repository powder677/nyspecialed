               checks: ["Plazos del CSE y contactos por distrito", "Derechos del IEP y plazos de evaluación", "Qué decir en su próxima reunión", "Resultados reales de padres en su distrito"],
               button: "Recibir Actualizaciones Gratis"
            }
         };
         var copy = COPY[LANG] || COPY.en;
         var STORAGE_KEY = "ec_dismissed_" + SITE + "_" + LANG;
         if (localStorage.getItem(STORAGE_KEY)) return;
